{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "statusMessage": "Loading turbocharge..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^turbocharge:builder$",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/builder-exit-gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/builder-exit-gate.sh\""
          }
        ]
      }
    ]
  }
}
