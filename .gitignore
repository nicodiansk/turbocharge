# Project-level CLAUDE.md (user-specific, not part of plugin distribution)
CLAUDE.md

# Docs folder (drafts, plans, notes — not part of plugin distribution)
docs/

# Report data (private usage analytics)
report.html

# Scratch/screenshot images — repo art lives in images/ as SVG; PNGs are strays
/*.png
images/*.png

# Turbocharge session snapshot (per-user, zero-tool-call resume)
.claude/turbocharge-session.json

# Per-user Claude local state — NOT team-shared (unlike .claude/settings.json,
# which stays committable). Deliberately scoped to these items, not all of .claude/.
.claude/settings.local.json
.claude/agent-memory/
.claude/worktrees/

# Codemap index (local, auto-generated)
.codemap/

# Stray third-party tool clone (github.com/AZidan/codemap) — not part of this plugin
/codemap/

# Session state (user-specific, not committed)
.turbocharge/memory/
.turbocharge/wrap/

# Sibling marketplace clone (historical — for reference during v2.3.0 consolidation)
turbocharge-marketplace/

# Node modules (if any)
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
.nyc_output/
